<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 2004 SDK for Windows' own PDF renderer (Windows.Data.Pdf, PdfRender.cs); the
         app still runs on Windows 10 1809 and later, as the Store manifest says. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>mdEditor</AssemblyName>
    <RootNamespace>MdEditor</RootNamespace>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <ApplicationIcon>wwwroot\assets\5garashi_mark_simple.ico</ApplicationIcon>
    <!-- The version is kept only in the VERSION file at the repository root. -->
    <Version>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)\VERSION').Trim())</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <!-- Published copies (setup.ps1, store\build-msix.ps1) are compiled ahead of time, so less
         code is compiled while the window opens. -->
    <PublishReadyToRun>true</PublishReadyToRun>
  </PropertyGroup>
  <!-- The Windows projection (Windows.Data.Pdf and the rest of Windows' own API: 24 MB, with
       the C#/WinRT runtime) is used only to draw a PDF page. Windows SDK's terms let it be
       distributed only unmodified, and the single-file exe would compile it into its one
       composite image ahead of time (about 40 MB more; PublishReadyToRunExclude does not reach
       the composite). It is taken out of the compile lists and only referenced, so it ships as
       it is. -->
  <Target Name="KeepWindowsProjectionAsIs" AfterTargets="_PrepareForReadyToRunCompilation">
    <ItemGroup>
      <_WindowsProjection Include="@(_ReadyToRunCompositeBuildInput)" Condition="'%(Filename)%(Extension)' == 'Microsoft.Windows.SDK.NET.dll' or '%(Filename)%(Extension)' == 'WinRT.Runtime.dll'" />
      <_ReadyToRunCompositeBuildInput Remove="@(_WindowsProjection)" />
      <_ReadyToRunCompositeUnrootedBuildInput Remove="@(_WindowsProjection)" />
      <_ReadyToRunCompositeBuildReferences Include="@(_WindowsProjection)" />
      <_ReadyToRunCompileList Remove="@(_ReadyToRunCompileList)" Condition="'%(Filename)%(Extension)' == 'Microsoft.Windows.SDK.NET.dll' or '%(Filename)%(Extension)' == 'WinRT.Runtime.dll'" />
      <_ReadyToRunFilesToPublish Remove="@(_ReadyToRunFilesToPublish)" Condition="'%(Filename)%(Extension)' == 'Microsoft.Windows.SDK.NET.dll' or '%(Filename)%(Extension)' == 'WinRT.Runtime.dll'" />
    </ItemGroup>
  </Target>
  <ItemGroup>
    <!-- WebView2 serves these from a real folder, so keep them beside the single-file exe. -->
    <Content Include="wwwroot\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- Binary redistribution must carry the licenses (MIT, BSD, Apache), the privacy policy, and the
         changelog (Identity 12-6; Quality Rules 6-1 "distribution"). -->
    <None Include="LICENSE;THIRD-PARTY-NOTICES.md;PRIVACY.md;CHANGELOG.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </None>
    <!-- The rendering tests in samples/ also open from the Samples dialog. -->
    <Content Include="samples\diagram-test.md;samples\diagram-test.en.md;samples\diagram-test.zh-CN.md">
      <Link>wwwroot\samples\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <!-- The video that diagram-test plays (21-3) and the official 5garashi.com assets its
         image size and position examples use (22), unmodified, beside it as in samples/. -->
    <Content Include="samples\import-test_files\cube5.mp4;samples\import-test_files\5garashi_*.svg;samples\import-test_files\5garashi_*.png">
      <Link>wwwroot\samples\import-test_files\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Remove="wwwroot\assets\5garashi_mark_simple.ico" />
    <Resource Include="wwwroot\assets\5garashi_mark_simple.ico" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" Version="3.5.1" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="Mammoth" Version="1.13.0" />
    <PackageReference Include="Markdig" Version="1.4.0" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4258.31" />
    <PackageReference Include="MimeKitLite" Version="4.18.1" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="ReverseMarkdown" Version="6.2.1" />
    <PackageReference Include="YamlDotNet" Version="18.1.0" />
  </ItemGroup>
</Project>
