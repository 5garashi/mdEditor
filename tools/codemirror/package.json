{
  "name": "mdeditor-codemirror-bundle",
  "private": true,
  "description": "Builds wwwroot/lib/codemirror/codemirror.min.js for mdEditor",
  "license": "MIT",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=iife --legal-comments=eof --outfile=../../wwwroot/lib/codemirror/codemirror.min.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.3",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/lint": "6.9.7",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.12",
    "@lezer/highlight": "1.2.5",
    "@lezer/markdown": "1.8.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
