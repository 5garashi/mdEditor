{
  "name": "mdeditor-markdownlint-bundle",
  "private": true,
  "description": "Builds wwwroot/lib/markdownlint/markdownlint.min.js for mdEditor",
  "license": "MIT",
  "scripts": {
    "build": "esbuild entry.js --bundle --minify --format=iife --platform=browser --legal-comments=eof --outfile=../../wwwroot/lib/markdownlint/markdownlint.min.js"
  },
  "dependencies": {
    "markdownlint": "0.41.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
